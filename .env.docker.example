# Copy to .env.local for the host-run Next.js app and verification scripts.
# Matches compose.local.yml defaults; override both URLs when changing ports/password.
DATABASE_URL=postgresql://cerebro:cerebro_dev_only@127.0.0.1:55432/cerebro?schema=public
REDIS_URL=redis://127.0.0.1:56380
DRY_RUN=true
NODE_ENV=development

# Required only for model-backed agents/evals. Never commit a real key.
# OPENROUTER_API_KEY=

# Live browser activity uses local Redis Pub/Sub plus PostgreSQL-backed refreshes.
