# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (direct or pooler URI from Supabase → Settings → Database).
# If Prisma reports "empty host", URL-encode special characters in the password (@ # : → %40 %23 %3A).
# Required for Prisma and the app.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# OpenRouter API key. Create at https://openrouter.ai/keys — required for agents and LLM scorers.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional: override default OpenRouter model ids (defaults in src/lib/config.ts).
# AUT / agents use MODEL_DEV; soft judges use MODEL_EVAL_JUDGE only.
# Never set these to openrouter/auto for evals (judge drift / non-comparable scores).
MODEL_DEV=moonshotai/kimi-k2
MODEL_DEMO=moonshotai/kimi-k2
MODEL_EVAL_JUDGE=moonshotai/kimi-k2

# Optional Pilot: escalate soft judge on unknown/NEEDS_REVIEW (requires EVAL_JUDGE_CASCADE=true).
# MODEL_EVAL_JUDGE_ESCALATE=
# EVAL_JUDGE_CASCADE=false

# Exact in-process judge-result cache (default true). Semantic caches are unsupported.
# EVAL_JUDGE_CACHE=true

# Optional live-eval USD budget gate (0 = disabled).
# EVAL_BUDGET_USD=0

# ── Queue (BullMQ) ───────────────────────────────────────────────────────────
# Redis URL for BullMQ (workers, simulation jobs). Local: redis://localhost:6379 — Upstash works for cloud.
REDIS_URL=redis://localhost:6379

# ── App ─────────────────────────────────────────────────────────────────────
# Supabase project URL (REST / Realtime). Defaults in config if unset for local-only dev.
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (browser client). Pair with NEXT_PUBLIC_* for SSR/client components.
SUPABASE_ANON_KEY=your_anon_key

# Used by client-side Supabase helpers — typically same URL and anon key as above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Resend API key for outbound email. Required when not in DRY_RUN for real sends.
RESEND_API_KEY=re_your_key_here

# Fixed "current" datetime for demos and deterministic tests (ISO 8601). Strongly recommended for local dev.
DEMO_DATE=2025-03-20T12:00:00.000Z

# When true, emails and other side effects are suppressed; DB writes still occur per project rules.
DRY_RUN=true

# Node environment: development | production | test
NODE_ENV=development

# Shared secret for Supabase → app webhooks (document upload pipeline).
WEBHOOK_SECRET=your_webhook_secret

# Optional: Supabase service role for server-side Realtime broadcast (omit if unused).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: secret for GET /api/cron/scheduled-scans (omit disables cron auth check path).
CRON_SECRET=

# Simulation time scaling (defaults to 1). Used where sim time is derived from config.
SIM_TIME_SCALE=1

# Optional: CI git SHA stored on EvalRun rows when running evals in pipelines.
GITHUB_SHA=

# Cap shared Mastra @mastra/pg pool size (default 5). Lower on Supabase if you hit connection limits.
MASTRA_PG_POOL_MAX=5

# Self-correcting prompt pipeline — max consecutive gate rejections before enqueue is blocked (default 3).
MUTATION_MAX_CONSECUTIVE_REJECTIONS=3

# Minimum minutes between mutation-analysis enqueues (default 5).
MUTATION_COOLDOWN_MINUTES=5

# Hours to pause new enqueues after circuit trips (default 24). Set 0 to block until manual reset.
MUTATION_CIRCUIT_PAUSE_HOURS=24

# ── Cheap-eval CI guards (optional) ───────────────────────────────────────────
# Opt-in live OpenRouter Vitest lane (default false — unit/fixture CI stays $0).
# CI_LIVE_EVAL=false

# Allow `--suite full` under CI (nightly/pre-release only). Default false —
# PR CI must use canary or the fixture unit lane (never full×live by default).
# EVAL_ALLOW_FULL_IN_CI=false

# Opt-in live canary LOO after inconclusive fixture ablation (cheap-eval PR4 Pilot).
# Default false — fixture tool-mask LOO stays $0 OpenRouter (`npm run eval:ablate`).
# EVAL_LIVE_ABLATION=false

# ── Agent runtime / capability (optional) ─────────────────────────────────────
# Mastra generate step budget (default 12; max 32).
# AGENT_MAX_STEPS=12

# Document field extract adapter (default heuristic). `docling` is a stub only.
# DOCUMENT_EXTRACT_PROVIDER=heuristic

# ── Flag-off scaffolds (optional; defaults keep production path unchanged) ────
# Observational Memory (T2.1). Default false; still disabled under DRY_RUN/test.
# AGENT_OBSERVATIONAL_MEMORY=false

# Sanctions/PEP seam (T2.4). dry-run never claims clearance; alloy is unconfigured.
# SANCTIONS_CHECK_PROVIDER=dry-run

# SOTA watch-only helpers (all default off — no Temporal rewrite, no live MCP).
# DURABLE_ENGINE_PROBE=false
# HYBRID_COST_CASCADE=false
# EXPERIMENT_SIDECAR=off
# EVIDENCE_SEAL=false
# AGENT_AS_JUDGE=false
# MCP_INTEGRATION_SURFACE=false
